# Package a clean release checkout's locally built, verified Vite artifact.
FROM nginx:stable-alpine
WORKDIR /app
ARG COMMIT_ID
ARG PROJECT_VERSION
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/replace-env-vars.sh /docker-entrypoint.d/50-replace-env-vars.sh
COPY build/ /app/
LABEL org.opencontainers.image.revision="$COMMIT_ID" org.opencontainers.image.version="$PROJECT_VERSION"
